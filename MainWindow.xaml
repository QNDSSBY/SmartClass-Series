<Window
    x:Class="SmartClassNight.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="智慧课堂系统">

    <Grid x:Name="RootGrid">
        <!-- 仿 Office 2016 启动画面（应用图标 + 名称 + 底部细进度条） -->
        <Grid x:Name="StartupSplash" Background="White" Visibility="Visible">
            <Grid.Resources>
                <!-- 进场：淡入 + 轻微放大 -->
                <Storyboard x:Name="SplashEntranceSb">
                    <DoubleAnimation Storyboard.TargetName="SplashPanel"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.45"/>
                    <DoubleAnimation Storyboard.TargetName="SplashPanelScale"
                                     Storyboard.TargetProperty="ScaleX"
                                     From="0.94" To="1" Duration="0:0:0.55">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="SplashPanelScale"
                                     Storyboard.TargetProperty="ScaleY"
                                     From="0.94" To="1" Duration="0:0:0.55">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
                <!-- 底部进度条从左向右填充 -->
                <Storyboard x:Name="SplashFillSb">
                    <DoubleAnimation Storyboard.TargetName="SplashBar"
                                     Storyboard.TargetProperty="Width"
                                     From="0" To="486" Duration="0:0:4.1">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
                <!-- 退场：整体淡出后切到桌面 -->
                <Storyboard x:Name="SplashExitSb">
                    <DoubleAnimation Storyboard.TargetName="StartupSplash"
                                     Storyboard.TargetProperty="Opacity"
                                     From="1" To="0" Duration="0:0:0.3"/>
                </Storyboard>
            </Grid.Resources>

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 中部：图标 + 应用名 / 版本（Office 2016 启动画面式布局） -->
            <StackPanel x:Name="SplashPanel" Grid.Row="0" Orientation="Horizontal"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Opacity="0" RenderTransformOrigin="0.5,0.5">
                <StackPanel.RenderTransform>
                    <CompositeTransform x:Name="SplashPanelScale"/>
                </StackPanel.RenderTransform>

                <Border Width="120" Height="120" CornerRadius="20" BorderThickness="1"
                        Background="White" BorderBrush="#FFD9D9D9">
                    <Image x:Name="SplashIcon" Width="112" Height="112" Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Margin="28,0,0,0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="SplashTitleText" Text="智慧课堂系统"
                               FontSize="42" FontWeight="SemiBold" Foreground="#FF3B3B3B"/>
                    <TextBlock x:Name="SplashVersionText" Text="V1.1.6" FontSize="19"
                               Foreground="#FF8C8C8C" Margin="0,6,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- 底部：Office 风格细长加载进度条 -->
            <Border Grid.Row="1" Width="486" Height="7" CornerRadius="3.5"
                    Background="#FFECECEC" HorizontalAlignment="Center" Margin="0,0,0,110">
                <Rectangle x:Name="SplashBar" RadiusX="3.5" RadiusY="3.5"
                           Fill="#FF2B7DE9" HorizontalAlignment="Left" Width="0"/>
            </Border>
        </Grid>

        <!-- 外部网页层 -->
        <Grid x:Name="WebViewGrid" Visibility="Collapsed">
            <WebView2 x:Name="WebView"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      XYFocusKeyboardNavigation="Enabled"
                      IsTabStop="True"/>
            <!-- 返回课堂桌面按钮 -->
            <Button x:Name="BackToDesktopFromWebButton" Content="返回主页面"
                    FontSize="14" FontWeight="SemiBold"
                    Background="#E8FFFFFF" Foreground="#FF1A1A1A"
                    BorderBrush="#FFCCCCCC" BorderThickness="1"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="16,16,0,0" Padding="12,6" CornerRadius="6"
                    Click="BackToDesktopFromWeb_Click" Visibility="Visible"/>
        </Grid>

        <!-- 智慧课堂系统层（背景由代码动态加载） -->
        <Grid x:Name="SmartClassGrid" Visibility="Collapsed">
            <Grid.Resources>
                <!-- 任务栏毛玻璃背景 -->
                <AcrylicBrush x:Key="TaskbarAcrylicBrush" TintColor="#FFFFFF" TintOpacity="0.35"
                              TintLuminosityOpacity="0.6" FallbackColor="#E8FFFFFF"/>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Frame x:Name="ContentFrame" Grid.Row="0"/>

            <!-- 任务栏（Win11 风格：居中图标 + 右侧系统托盘；背景同样做高斯模糊半透明） -->
            <Border x:Name="TaskbarBorder" Grid.Row="1" Height="48"
                    Background="{StaticResource TaskbarAcrylicBrush}"
                    Padding="0" RenderTransformOrigin="0,0">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="TaskbarTransform" Y="0"/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 居中：开始按钮 + 应用图标（仅图标 + 悬停药丸） -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <!-- 开始按钮（Windows 徽标） -->
                        <Button x:Name="StartButton" Width="40" Height="40" Padding="0" Margin="0,0,6,0"
                                Background="Transparent" CornerRadius="8"
                                ToolTipService.ToolTip="开始" Click="StartButton_Click">
                            <FontIcon Glyph="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                      Foreground="#FF1A1A1A"/>
                            <Button.Flyout>
                                <Flyout>
                                    <StackPanel Width="200" Padding="10">
                                        <Button Content="电源" HorizontalAlignment="Stretch" Margin="0,2"
                                                Click="PowerButton_Click"/>
                                        <Button Content="设置" HorizontalAlignment="Stretch" Margin="0,2"
                                                Click="StartSettings_Click"/>
                                        <Button Content="文件资源管理器" HorizontalAlignment="Stretch" Margin="0,2"
                                                Click="ExplorerButton_Click"/>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <!-- 任务栏应用（窗口图标 + 工具提示，悬停显示药丸背景） -->
                        <ItemsControl x:Name="TaskbarAppsList" Background="Transparent">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Height="40" MinWidth="0" Padding="8,0" Margin="2,0"
                                            Background="Transparent" CornerRadius="8"
                                            Click="TaskbarApp_Click" Tag="{Binding Hwnd}"
                                            ToolTipService.ToolTip="{Binding Title}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Image Source="{Binding Icon}" Width="22" Height="22" Stretch="Uniform"
                                                   VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Title}" FontSize="12" Foreground="#FF1A1A1A"
                                                       VerticalAlignment="Center" MaxWidth="140"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 系统托盘（右侧：时间/日期 + 网络/音量/电池 + 显示桌面细条） -->
                    <Grid Grid.Column="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="6"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                            <!-- 时间/日期 → 打开日期时间设置 -->
                            <Button x:Name="ClockButton" Background="Transparent" Padding="6,2" MinWidth="0"
                                    MinHeight="0" CornerRadius="6"
                                    ToolTipService.ToolTip="日期和时间设置" Click="ClockButton_Click">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Right">
                                    <TextBlock x:Name="TaskbarTime" Text="12:00" Foreground="#FF1A1A1A"
                                               FontSize="12" FontWeight="SemiBold" TextAlignment="Right"/>
                                    <TextBlock x:Name="TaskbarDate" Text="2026/1/1" Foreground="#FF1A1A1A"
                                               FontSize="10" Opacity="0.7" TextAlignment="Right"/>
                                </StackPanel>
                            </Button>
                            <!-- 网络 → 网络设置 -->
                            <Button x:Name="NetworkButton" Width="32" Height="32" Padding="0" MinWidth="0"
                                    MinHeight="0" Background="Transparent" CornerRadius="6"
                                    ToolTipService.ToolTip="网络设置" Click="NetworkButton_Click">
                                <FontIcon Glyph="&#xE7011;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                          Foreground="#FF1A1A1A"/>
                            </Button>
                            <!-- 勿扰模式（侧边栏开关）：开启后不做消息提醒，打铃不受影响 -->
                            <Button x:Name="DndButton" Width="32" Height="32" Padding="0" MinWidth="0"
                                    MinHeight="0" Background="Transparent" CornerRadius="6"
                                    ToolTipService.ToolTip="勿扰模式（不提醒消息，打铃照常）" Click="DndButton_Click">
                                <FontIcon x:Name="DndIcon" Glyph="&#xE708;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                          Foreground="#FF1A1A1A"/>
                            </Button>
                            <!-- 音量 → 音量合成器 -->
                            <Button x:Name="VolumeButton" Width="32" Height="32" Padding="0" MinWidth="0"
                                    MinHeight="0" Background="Transparent" CornerRadius="6"
                                    ToolTipService.ToolTip="音量合成器" Click="VolumeButton_Click">
                                <FontIcon Glyph="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                          Foreground="#FF1A1A1A"/>
                            </Button>
                            <!-- 电池 → 电源设置 -->
                            <Button x:Name="BatteryButton" Width="32" Height="32" Padding="0" MinWidth="0"
                                    MinHeight="0" Background="Transparent" CornerRadius="6"
                                    ToolTipService.ToolTip="电源设置" Click="BatteryButton_Click">
                                <FontIcon Glyph="&#xEBA0;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                          Foreground="#FF1A1A1A"/>
                            </Button>
                        </StackPanel>
                        <!-- 最右侧“显示桌面”细条 → 最小化所有其他窗口 -->
                        <Button Grid.Column="2" Width="8" Height="28" Padding="0" MinWidth="0" MinHeight="0"
                                Background="Transparent" CornerRadius="2" VerticalAlignment="Center"
                                ToolTipService.ToolTip="显示桌面" Click="ShowDesktopButton_Click">
                            <Border Width="2" Background="#33000000" CornerRadius="1" Height="20"/>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- “更多功能”按钮 -->
        <Button x:Name="MoreFeaturesButton" Content="更多功能"
                FontSize="14" FontWeight="SemiBold"
                Background="#E8FFFFFF" Foreground="#FF1A1A1A"
                BorderBrush="#FFCCCCCC" BorderThickness="1"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="16,16,0,0" Padding="12,6" CornerRadius="6"
                Click="MoreFeaturesButton_Click" Visibility="Collapsed"/>

        <!-- 退出按钮 -->
        <Button x:Name="ExitButton" Content="✕" Width="60" Height="60"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0"
                Background="White" Foreground="#CC333333" FontSize="28"
                Click="ExitButton_Click" BorderThickness="0" CornerRadius="30"/>

        <!-- 图片预览：屏幕中心弹窗，可缩放、可拖拽（点击空白处关闭） -->
        <Grid x:Name="ImagePreviewHost" Background="#B3000000" Visibility="Collapsed"
              Tapped="ImagePreviewBackdrop_Tapped">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ScrollViewer x:Name="ImagePreviewScroll" Grid.Row="0"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          ZoomMode="Enabled" MinZoomFactor="0.3" MaxZoomFactor="8"
                          HorizontalScrollMode="Enabled" VerticalScrollMode="Enabled"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          PointerWheelChanged="ImagePreviewScroll_PointerWheelChanged"
                          Tapped="ImagePreviewScroll_Tapped"
                          PointerPressed="ImagePreviewScroll_PointerPressed"
                          PointerMoved="ImagePreviewScroll_PointerMoved"
                          PointerReleased="ImagePreviewScroll_PointerReleased"
                          PointerCaptureLost="ImagePreviewScroll_PointerReleased">
                <Image x:Name="ImagePreviewImage" Stretch="Uniform"/>
            </ScrollViewer>
            <!-- 加载中 / 加载失败提示 -->
            <TextBlock x:Name="ImagePreviewHint" Grid.Row="0"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="White" FontSize="16" TextWrapping="Wrap"
                       MaxWidth="620" TextAlignment="Center" Visibility="Collapsed"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center"
                        Spacing="12" Margin="0,16,0,28">
                <Button Content="缩小" Click="ImagePreviewZoomOut_Click"/>
                <Button Content="放大" Click="ImagePreviewZoomIn_Click"/>
                <Button Content="关闭" Click="ImagePreviewClose_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

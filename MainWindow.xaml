<Window
    x:Class="SmartClassNight.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="智慧课堂系统">

    <Grid x:Name="RootGrid">
        <!-- 视频启动画面 -->
        <MediaPlayerElement x:Name="StartupVideo"
                            Source="D:\Smart_Class\start.mp4"
                            AutoPlay="True"
                            AreTransportControlsEnabled="False"
                            Stretch="UniformToFill"
                            Visibility="Visible"/>

        <!-- 外部网页层 -->
        <Grid x:Name="WebViewGrid" Visibility="Collapsed">
            <WebView2 x:Name="WebView"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      XYFocusKeyboardNavigation="Enabled"
                      IsTabStop="True"/>
            <!-- 返回课堂桌面按钮 -->
            <Button x:Name="BackToDesktopFromWebButton" Content="返回课堂桌面"
                    FontSize="14" FontWeight="SemiBold"
                    Background="#CC1E3A8A" Foreground="White"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="16,16,0,0" Padding="12,6" CornerRadius="4"
                    Click="BackToDesktopFromWeb_Click" Visibility="Visible"/>
        </Grid>

        <!-- 智慧课堂系统层（背景由代码动态加载） -->
        <Grid x:Name="SmartClassGrid" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Frame x:Name="ContentFrame" Grid.Row="0"/>

            <!-- 任务栏（浅色） -->
            <Border x:Name="TaskbarBorder" Grid.Row="1" Background="#CCFFFFFF" Height="48"
                    Padding="8,0" RenderTransformOrigin="0,0">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="TaskbarTransform" Y="0"/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 开始按钮 -->
                    <Button Grid.Column="0" Width="44" Height="44" Background="Transparent"
                            Foreground="#FF1A1A1A" FontSize="22" FontFamily="Segoe MDL2 Assets"
                            Content="&#xE712;" Click="StartButton_Click">
                        <Button.Flyout>
                            <Flyout>
                                <StackPanel Width="200" Padding="10">
                                    <Button Content="电源" HorizontalAlignment="Stretch" Margin="0,2"
                                            Click="PowerButton_Click"/>
                                    <Button Content="设置" HorizontalAlignment="Stretch" Margin="0,2"
                                            Click="StartSettings_Click"/>
                                    <Button Content="文件资源管理器" HorizontalAlignment="Stretch" Margin="0,2"
                                            Click="ExplorerButton_Click"/>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <!-- 任务栏应用列表 -->
                    <ListView x:Name="TaskbarAppsList" Grid.Column="1"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              Background="Transparent" SelectionMode="Single">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Button Height="40" Background="Transparent" Foreground="#FF1A1A1A"
                                        FontSize="12" Padding="8,4" Click="TaskbarApp_Click"
                                        Tag="{Binding Hwnd}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE737;" FontSize="14"/>
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                                                   MaxWidth="150" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- 系统托盘 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                        <TextBlock x:Name="TaskbarTime" Text="12:00" Foreground="#FF1A1A1A" FontSize="14"
                                   VerticalAlignment="Center"/>
                        <FontIcon Glyph="&#xEC90;" FontSize="18" Foreground="#FF1A1A1A" VerticalAlignment="Center"/>
                        <FontIcon Glyph="&#xE767;" FontSize="18" Foreground="#FF1A1A1A" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- “更多功能”按钮 -->
        <Button x:Name="MoreFeaturesButton" Content="更多功能"
                FontSize="14" FontWeight="SemiBold"
                Background="#CC1E3A8A" Foreground="White"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="16,16,0,0" Padding="12,6" CornerRadius="4"
                Click="MoreFeaturesButton_Click" Visibility="Collapsed"/>

        <!-- 退出按钮 -->
        <Button x:Name="ExitButton" Content="✕" Width="60" Height="60"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0"
                Background="White" Foreground="#CC333333" FontSize="28"
                Click="ExitButton_Click" BorderThickness="0" CornerRadius="30"/>
    </Grid>
</Window>
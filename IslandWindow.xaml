<Window
    x:Class="SmartClassNight.IslandWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="灵动岛">

    <!-- 灵动岛独立窗口：无边框、置顶、不接受激活（点击不抢焦点），窗口形状用圆角矩形区域裁剪成胶囊/卡片。
         根节点直接铺纯黑：胶囊以外即便是半像素缝隙也不会出现白边；空闲时常驻为纯黑胶囊。 -->
    <Grid x:Name="IslandRoot" Background="#FF000000">
        <Grid.Resources>
            <!-- 纯黑不透明背景 + 白字（不使用玻璃/高光/边框等图案） -->
            <SolidColorBrush x:Key="IslandCardBrush" Color="#FF000000"/>
            <SolidColorBrush x:Key="IslandTextPrimaryBrush" Color="#FFF5F5FA"/>
            <SolidColorBrush x:Key="IslandTextSecondaryBrush" Color="#B3F5F5FA"/>
            <SolidColorBrush x:Key="IslandAccentBrush" Color="#FF6C5CE7"/>
            <SolidColorBrush x:Key="IslandPushCardBrush" Color="#FF101010"/>
            <SolidColorBrush x:Key="IslandPushBorderBrush" Color="#26FFFFFF"/>
        </Grid.Resources>

        <Grid x:Name="IslandSize" Width="150" Height="40"
              HorizontalAlignment="Left" VerticalAlignment="Top">
            <!-- 卡片：单一圆角（默认 28；高度 40 时收敛为高度一半 → 中间长方形 + 两端半圆）
                 卡片会按代码里的 Overhang 向外多画 3 DIP（盖满窗口客户区，杜绝边缘白线），
                 内层内容用 Margin 抵消这 3 DIP，保证内容仍与胶囊严格对齐。 -->
            <Border x:Name="IslandCard" Background="{StaticResource IslandCardBrush}"
                    CornerRadius="20" Margin="-3" Tapped="IslandCard_Tapped">
                <Grid Margin="3,3,0,0">
                    <!-- ============ 展开态：消息横幅（静止 2 秒 → 横向滚动两遍 → 自动收起并隐藏） ============ -->
                    <Grid x:Name="IslandExpandedContent" Opacity="0" Visibility="Collapsed" Padding="12,10">
                        <!-- 纯黑一体：内层卡片不再有白边/浅色描边（只靠留白区分层次） -->
                        <Border x:Name="IslandPushCard" CornerRadius="14"
                                Background="Transparent" BorderThickness="0" Padding="12,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- 来源行：强调色图标块 + 来自X老师 -->
                                <StackPanel x:Name="IslandSenderPanel" Orientation="Horizontal" Spacing="8">
                                    <StackPanel.RenderTransform>
                                        <TranslateTransform x:Name="IslandSenderTransform" Y="10"/>
                                    </StackPanel.RenderTransform>
                                    <Border Width="26" Height="26" CornerRadius="9"
                                            Background="{StaticResource IslandAccentBrush}">
                                        <Image x:Name="IslandIcon" Width="16" Height="16" Stretch="Uniform"/>
                                    </Border>
                                    <TextBlock x:Name="IslandSenderText" Text="班级通知" FontSize="13"
                                               Foreground="{StaticResource IslandTextSecondaryBrush}"
                                               MaxLines="1" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- 正文区：先静态“收到新消息”，随后单行从右向左滚动两遍 -->
                                <Grid x:Name="IslandContentView" Grid.Row="1" VerticalAlignment="Center"
                                      Margin="0,4,0,0">
                                    <Grid.RenderTransform>
                                        <TranslateTransform x:Name="IslandContentTransform" Y="10"/>
                                    </Grid.RenderTransform>
                                    <TextBlock x:Name="IslandHeadlineText" Text="收到新消息"
                                               Foreground="{StaticResource IslandTextPrimaryBrush}"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <!-- 跑马灯宿主用 Canvas：Canvas 不限制子元素尺寸，长文本才能按真实宽度完整渲染 -->
                                    <Canvas x:Name="IslandMarqueeViewport" Visibility="Collapsed">
                                        <TextBlock x:Name="IslandMarqueeText" Text=""
                                                   Canvas.Left="0"
                                                   Foreground="{StaticResource IslandTextPrimaryBrush}"
                                                   TextWrapping="NoWrap">
                                            <TextBlock.RenderTransform>
                                                <TranslateTransform x:Name="IslandMarqueeTransform" X="0"/>
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                    </Canvas>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ============ 信息条（点歌播放中 / 打铃中）：左右拉长、高度不变，
                         左侧标题、右侧时间或任务名 ============ -->
                    <Grid x:Name="IslandInfoContent" Opacity="0" Visibility="Collapsed" Padding="18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="IslandInfoLeftText" Text=""
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource IslandTextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" MaxLines="1"
                                   VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="IslandInfoRightText" Grid.Column="1" Text=""
                                   FontSize="15"
                                   Foreground="{StaticResource IslandTextSecondaryBrush}"
                                   MaxLines="1" Margin="12,0,0,0"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- ============ 方形历史视图（消息显示中点击灵动岛进入） ============ -->
                    <Grid x:Name="IslandHistoryContent" Opacity="0" Visibility="Collapsed" Padding="18,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Tapped="IslandHistoryHeader_Tapped">
                            <TextBlock Text="历史消息" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{StaticResource IslandTextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="IslandHistoryClose" Content="✕" Width="34" Height="34"
                                    HorizontalAlignment="Right" Padding="0" CornerRadius="17"
                                    Background="#22FFFFFF" Foreground="{StaticResource IslandTextPrimaryBrush}"
                                    BorderThickness="0" Click="IslandHistoryClose_Click"/>
                        </Grid>
                        <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollMode="Disabled" Tapped="IslandHistoryList_Tapped">
                            <StackPanel x:Name="IslandHistoryList" Spacing="8"/>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

<Page x:Class="SmartClassNight.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧导航列表 -->
        <Grid Grid.Column="0" Background="#FFF0F0F0" Width="220">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Button Content="← 返回主页" FontSize="14" FontWeight="SemiBold"
                    Background="#FF1E3A8A" Foreground="White"
                    Margin="12,12,12,4" Padding="10,6"
                    HorizontalAlignment="Stretch"
                    Click="BackToHome_Click"/>

            <TextBlock Text="设置" FontSize="28" FontWeight="Bold" Foreground="#FF1E3A8A"
                       Margin="20,8,20,8" Grid.Row="1"/>

            <ListView x:Name="NavListView" Grid.Row="2" SelectionChanged="NavListView_SelectionChanged"
                      Background="Transparent" SelectionMode="Single">
                <ListViewItem Content="个性化" Tag="Personalization"/>
                <ListViewItem Content="应用管理" Tag="Apps"/>
                <ListViewItem Content="任务栏" Tag="Taskbar"/>
                <ListViewItem Content="预览体验计划" Tag="Preview"/>
                <ListViewItem Content="更新与反馈" Tag="Update"/>
                <ListViewItem Content="关于" Tag="About"/>
                <!-- ClassIsland 相关入口 -->
                <ListViewItem Content="ClassIsland 设置" Tag="ClassIsland"/>
                <ListViewItem Content="ClassIsland 档案" Tag="ClassIslandProfile"/>
            </ListView>
        </Grid>

        <ContentControl x:Name="SettingsContentControl" Grid.Column="1"/>
    </Grid>
</Page>
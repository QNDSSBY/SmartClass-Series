<UserControl x:Class="SmartClassNight.MusicPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:media="using:Microsoft.UI.Xaml.Media">

    <UserControl.Resources>
        <!-- 与桌面模块一致的玻璃卡片样式 -->
        <AcrylicBrush x:Key="CardAcrylicBrush" TintColor="#FFFFFF" TintOpacity="0.30"
                      TintLuminosityOpacity="0.55" FallbackColor="#D9FFFFFF"/>
        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardAcrylicBrush}"/>
            <Setter Property="BorderBrush" Value="#22000000"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#CC1A1A1A"/>
        </Style>
        <Style x:Key="CardSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#991A1A1A"/>
        </Style>
    </UserControl.Resources>

    <!-- 注意：留出左上角 20,62 的空白，避免与主窗口左上角的「更多功能」按钮重叠 -->
    <Grid Background="Transparent" Margin="20,62,20,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== 主体：左（唱片）/ 右（音波 + 播放列表） ==================== -->
        <Grid Grid.Row="0" Margin="14,12,14,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="55*"/>
                <ColumnDefinition Width="45*"/>
            </Grid.ColumnDefinitions>

            <!-- ==================== 左：黑胶唱片 + 歌曲信息 ==================== -->
            <Border Grid.Column="0" Style="{StaticResource GlassCard}" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <!-- 唱片本体：Grid 整体旋转（RenderTransform 已在代码中给出默认值） -->
                    <Grid x:Name="VinylHost" Width="260" Height="260">
                        <Grid.RenderTransform>
                            <RotateTransform x:Name="VinylRotate" Angle="0" CenterX="130" CenterY="130"/>
                        </Grid.RenderTransform>

                        <!-- 盘面：径向渐变（中心稍亮，向外变黑） -->
                        <Ellipse Width="260" Height="260">
                            <Ellipse.Fill>
                                <media:RadialGradientBrush>
                                    <media:GradientStop Color="#FF3A3A3A" Offset="0"/>
                                    <media:GradientStop Color="#FF141414" Offset="0.45"/>
                                    <media:GradientStop Color="#FF050505" Offset="1"/>
                                </media:RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>

                        <!-- 盘面外沿描边 -->
                        <Ellipse Width="258" Height="258" Stroke="#33FFFFFF" StrokeThickness="1.5"/>

                        <!-- 音轨纹路（细圆环） -->
                        <Ellipse Width="238" Height="238" Stroke="#1FFFFFFF" StrokeThickness="1"/>
                        <Ellipse Width="222" Height="222" Stroke="#26FFFFFF" StrokeThickness="1"/>
                        <Ellipse Width="206" Height="206" Stroke="#1FFFFFFF" StrokeThickness="1"/>
                        <Ellipse Width="190" Height="190" Stroke="#33FFFFFF" StrokeThickness="1"/>
                        <Ellipse Width="174" Height="174" Stroke="#1FFFFFFF" StrokeThickness="1"/>
                        <Ellipse Width="158" Height="158" Stroke="#26FFFFFF" StrokeThickness="1"/>

                        <!-- 中心封面（无封面时显示音符图标） -->
                        <Border Width="130" Height="130" CornerRadius="65"
                                Background="#FFEFEFEF" BorderBrush="#33FFFFFF" BorderThickness="1">
                            <Grid>
                                <FontIcon x:Name="CoverFallbackIcon" Glyph="&#xE8D6;"
                                          FontFamily="Segoe MDL2 Assets" FontSize="46"
                                          Foreground="#661A1A1A"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image x:Name="CoverImage" Stretch="UniformToFill"/>
                            </Grid>
                        </Border>

                        <!-- 中心轴孔 -->
                        <Ellipse Width="16" Height="16" Fill="#FFEDEDED" Stroke="#33000000" StrokeThickness="1"/>
                    </Grid>

                    <!-- 歌曲文字信息 -->
                    <StackPanel Width="330" Margin="34,0,0,0"
                                VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock x:Name="TrackTitleText"
                                   Text="未选择歌曲"
                                   FontSize="30" FontWeight="Bold"
                                   Foreground="#E61A1A1A"
                                   TextWrapping="Wrap" MaxLines="2"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TrackArtistText"
                                   Text="请从下方列表选择或“选择文件…”添加音频"
                                   FontSize="18" Foreground="#991A1A1A"
                                   TextWrapping="Wrap" MaxLines="2"
                                   Margin="0,10,0,0"/>
                        <TextBlock x:Name="TrackFileText"
                                   FontSize="13" Foreground="#801A1A1A"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,10,0,0"/>
                        <!-- 错误提示（正常时折叠） -->
                        <TextBlock x:Name="ErrorText"
                                   FontSize="13" Foreground="#FFC62828"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ==================== 右：音波可视化 + 播放列表 ==================== -->
            <Border Grid.Column="1" Style="{StaticResource GlassCard}" Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="音波" Style="{StaticResource CardTitle}"/>

                    <!-- 音波：30 根竖条在代码里生成（等宽 ColumnDefinition） -->
                    <Grid x:Name="SpectrumCanvas" Grid.Row="1"
                          Height="220" Margin="0,10,0,0"/>

                    <!-- 播放列表 -->
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" x:Name="PlaylistHeaderText"
                                   Text="播放列表（0 首）"
                                   Style="{StaticResource CardTitle}"
                                   Margin="0,0,0,6"/>

                        <ListView x:Name="PlaylistView" Grid.Row="1"
                                  MinHeight="120"
                                  SelectionMode="Single"
                                  SelectionChanged="PlaylistView_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,5" MaxWidth="520">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="#CC1A1A1A"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}"
                                                   FontSize="12" Foreground="#991A1A1A"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- 空列表提示（不拦截点击） -->
                        <TextBlock x:Name="PlaylistEmptyHint" Grid.Row="1"
                                   Text="列表为空，点击「选择文件…」添加本地音频"
                                   FontSize="13" Foreground="#991A1A1A"
                                   IsHitTestVisible="False"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 底部控制条 ==================== -->
        <Border Grid.Row="1" Style="{StaticResource GlassCard}" Margin="14,0,14,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 第一行：进度条 + 时间 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="CurrentTimeText" Grid.Column="0"
                               Text="00:00" FontSize="13" Foreground="#991A1A1A"
                               VerticalAlignment="Center" MinWidth="46"/>

                    <Slider x:Name="SeekSlider" Grid.Column="1"
                            Minimum="0" Maximum="1" Value="0"
                            StepFrequency="0.01" SmallChange="1"
                            VerticalAlignment="Center" Margin="10,0,10,0"
                            PointerPressed="SeekSlider_PointerPressed"
                            PointerCaptureLost="SeekSlider_PointerCaptureLost"
                            ValueChanged="SeekSlider_ValueChanged"/>

                    <TextBlock x:Name="TotalTimeText" Grid.Column="2"
                               Text="00:00" FontSize="13" Foreground="#991A1A1A"
                               VerticalAlignment="Center" MinWidth="46"
                               HorizontalAlignment="Right"/>
                </Grid>

                <!-- 第二行：播放控制 + 音量 -->
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="PrevButton" Click="PrevButton_Click" Padding="14,6" FontSize="14">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE892;" FontSize="14"/>
                                <TextBlock Text="上一曲" FontSize="14"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="PlayPauseButton" Click="PlayPauseButton_Click" Padding="18,6" FontSize="14"
                                Background="#FF2B7DE9" Foreground="White" BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="14"/>
                                <TextBlock x:Name="PlayPauseText" Text="播放" FontSize="14"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="NextButton" Click="NextButton_Click" Padding="14,6" FontSize="14">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE893;" FontSize="14"/>
                                <TextBlock Text="下一曲" FontSize="14"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="AddFilesButton" Click="AddFilesButton_Click" Padding="14,6" FontSize="14"
                                Content="选择文件…"/>

                        <Button x:Name="ClearButton" Click="ClearButton_Click" Padding="14,6" FontSize="14"
                                Content="清空列表"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="音量" FontSize="13" Foreground="#991A1A1A" VerticalAlignment="Center"/>
                        <Slider x:Name="VolumeSlider" Width="160"
                                Minimum="0" Maximum="100" Value="80"
                                StepFrequency="1"
                                VerticalAlignment="Center"
                                ValueChanged="VolumeSlider_ValueChanged"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
